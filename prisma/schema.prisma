generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ─────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  phone         String?
  image         String?
  role          Role      @default(CUSTOMER)

  addresses Address[]
  orders    Order[]
  reviews   Review[]
  wishlist  WishlistItem[]
  accounts  Account[]
  sessions  Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

enum Role {
  CUSTOMER
  ADMIN
}

enum GiftTier {
  MYSTERY
  CATEGORY_CHOICE
  PREMIUM
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Addresses ────────────────────────────────────────────────

model Address {
  id        String  @id @default(cuid())
  userId    String
  name      String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean @default(false)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([pincode])
}

// ─── Products ─────────────────────────────────────────────────

model Category {
  id          String @id @default(cuid())
  name        String @unique
  slug        String @unique
  description String?
  image       String?

  products ProductCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Collection {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  image       String?
  isFeatured  Boolean @default(false)

  products ProductCollection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id             String  @id @default(cuid())
  name           String
  slug           String  @unique
  tagline        String?
  description    String  @db.Text
  scentNotes     Json    // { top: [], middle: [], base: [] }
  burnTime       String?
  waxType        String?
  wickType       String?
  weight         String?
  howToUse       String? @db.Text
  safetyTips     String? @db.Text
  seoTitle       String?
  seoDescription String?
  isPublished    Boolean @default(false)
  isFeatured     Boolean @default(false)
  isBestseller   Boolean @default(false)
  hasSurpriseGift         Boolean   @default(false)
  giftTier                GiftTier?
  giftDescriptionInternal String?   @db.Text
  giftStock               Int       @default(0)
  giftStockHer            Int       @default(25)
  giftStockHim            Int       @default(25)
  giftStockAnyone         Int       @default(50)
  giftItemsHer            Json?     // ["earrings", "pendant", "ring", "bracelet"]
  giftItemsHim            Json?     // ["keychain", "ring", "bracelet", "cufflinks"]
  giftItemsAnyone         Json?     // ["brass charm", "coin", "keychain"]

  variants    Variant[]
  images      ProductImage[]
  categories  ProductCategory[]
  collections ProductCollection[]
  reviews     Review[]
  orderItems  OrderItem[]
  wishlist    WishlistItem[]
  backInStock BackInStockNotify[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([isPublished, isFeatured])
  @@index([isPublished, isBestseller])
}

model Variant {
  id        String  @id @default(cuid())
  productId String
  name      String
  sku       String  @unique
  price     Int     // in paise
  compareAt Int?    // original price (paise) for discount display
  stock     Int     @default(0)
  isDefault Boolean @default(false)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([sku])
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  url       String
  alt       String?
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductCategory {
  productId  String
  categoryId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

model ProductCollection {
  productId    String
  collectionId String

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

// ─── Orders ───────────────────────────────────────────────────

model Order {
  id              String @id @default(cuid())
  orderNumber     String @unique
  userId          String?
  guestEmail      String?
  guestPhone      String?
  addressId       String?
  shippingAddress Json   // snapshot of address at order time

  subtotal    Int // paise
  shippingFee Int // paise
  codFee      Int @default(0)
  discount    Int @default(0)
  gstAmount   Int // paise
  total       Int // paise

  couponId   String?
  couponCode String?

  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus   @default(PENDING)
  razorpayOrderId   String?         @unique
  razorpayPaymentId String?

  status         OrderStatus @default(PLACED)
  trackingNumber String?
  giftMessage    String?
  giftWrap       Boolean     @default(false)
  notes          String?

  user          User?              @relation(fields: [userId], references: [id])
  address       Address?           @relation(fields: [addressId], references: [id])
  coupon        Coupon?            @relation(fields: [couponId], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([razorpayOrderId])
  @@index([createdAt])
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  productId   String
  variantId   String
  name        String // snapshot
  variantName String // snapshot
  price       Int    // paise, snapshot
  quantity    Int
  total       Int    // paise
  giftAudience String? // HER | HIM | ANYONE

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  variant Variant @relation(fields: [variantId], references: [id])
  revealCodes RevealCode[]

  @@index([orderId])
}

model RevealCode {
  id           String     @id @default(cuid())
  code         String     @unique
  orderItemId  String?
  usedAt       DateTime?
  revealedAt   DateTime?
  giftPhotoUrl String?
  giftName     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  orderItem    OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([code])
  @@index([orderItemId])
}

model OrderStatusHistory {
  id      String      @id @default(cuid())
  orderId String
  status  OrderStatus
  note    String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orderId])
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  RAZORPAY
  COD
  UPI_DIRECT
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ─── Coupons ──────────────────────────────────────────────────

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  type        CouponType
  value       Int        // percentage (e.g. 20) or flat amount in paise
  minOrder    Int?       // paise
  maxDiscount Int?       // paise cap for percentage coupons
  usageLimit  Int?
  usedCount   Int        @default(0)
  isActive    Boolean    @default(true)
  expiresAt   DateTime?

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
}

enum CouponType {
  PERCENTAGE
  FLAT
}

// ─── Reviews ──────────────────────────────────────────────────

model Review {
  id         String  @id @default(cuid())
  productId  String
  userId     String
  rating     Int     // 1-5
  title      String?
  comment    String? @db.Text
  isVerified Boolean @default(false)
  isApproved Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId])
  @@index([productId, isApproved])
}

// ─── Wishlist ─────────────────────────────────────────────────

model WishlistItem {
  id        String @id @default(cuid())
  userId    String
  productId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ─── Back in Stock ────────────────────────────────────────────

model BackInStockNotify {
  id        String  @id @default(cuid())
  email     String
  productId String
  notified  Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([email, productId])
}

// ─── Newsletter ───────────────────────────────────────────────

model Newsletter {
  id    String @id @default(cuid())
  email String @unique

  createdAt DateTime @default(now())
}

// ─── Site Settings ────────────────────────────────────────────

model SiteSettings {
  id                    String  @id @default("default")
  festiveMode           Boolean @default(true)
  announcementText      String?
  announcementActive    Boolean @default(false)
  freeShippingThreshold Int     @default(99900) // paise
  codFee                Int     @default(4900)  // paise

  updatedAt DateTime @updatedAt
}

// ─── Serviceable Pincodes ─────────────────────────────────────

model ServiceablePincode {
  id           String  @id @default(cuid())
  pincode      String  @unique
  city         String
  state        String
  deliveryDays Int     @default(5)
  codAvailable Boolean @default(true)

  @@index([pincode])
}
